# ── Clerk Authentication (https://clerk.com) ──
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev

# ── Contact Form & Security (https://web3forms.com & https://hcaptcha.com) ──
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
HCAPTCHA_SITEKEY=50b2fe65-b00b-4b9e-ad62-3ba471098be2

# ── Socials & Profile Identity ──
GITHUB_USERNAME=your_github_username
TELEGRAM_USERNAME=your_telegram_username
X_USERNAME=your_x_username
CONTACT_EMAIL=your@email.com
SITE_NAME=your_site_name
ACCENT_LETTER=x

# ── Whitelist of Authorized Admins (comma-separated) ──
AUTHORIZED_USERS=your@email.com,your_username,your_admin_key

# ── Optional Cloudflare Analytics Token ──
CF_ANALYTICS=false

# ── Optional Favicon URL (Default: favicon.png) ──
FAVICON_URL=favicon.png

# ── Optional Avatar URL (Default: Diluc.svg) ──
AVATAR_URL=Diluc.svg
