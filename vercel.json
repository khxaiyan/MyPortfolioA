{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "buildCommand": "node backend/sync-env.js",
  "redirects": [
    {
      "source": "/frontend",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/frontend/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
