{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "buildCommand": "node backend/sync-env.js",
  "functions": {
    "api/inngest.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/config.js",
      "destination": "/api/config"
    },
    {
      "source": "/:file*.md",
      "destination": "/api/md?path=/:file*.md"
    },
    {
      "source": "/:file*.markdown",
      "destination": "/api/md?path=/:file*.markdown"
    }
  ],
  "redirects": [
    {
      "source": "/frontend",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/frontend/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
